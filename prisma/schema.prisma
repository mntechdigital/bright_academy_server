generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum RoleStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String        @id @default(uuid())
  name        String        @unique
  status      RoleStatus    @default(ACTIVE)
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roleFeature RoleFeature[]
  adminUser   AdminUser[]
}

model RoleFeature {
  id     String @id @default(uuid())
  name   String
  index  Int
  path   String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

enum AdminUserStatus {
  ACTIVE
  INACTIVE
}

model AdminUser {
  id           String          @id @default(uuid())
  fullName     String
  email        String          @unique
  password     String
  profilePhoto String?
  status       AdminUserStatus @default(ACTIVE)
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum Status {
  ACTIVE
  INACTIVE
}

model Student {
  id                 String              @id @default(uuid())
  name               String
  classId            String
  stdClass           StdClass            @relation(fields: [classId], references: [id], onDelete: Cascade, map: "Student_stdClass_fkey")
  batchId            String?
  batch              Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull, map: "Student_batch_fkey")
  parentPhone        String
  address            String
  gender             String
  stdRegNo           String?             @unique
  password           String?
  weeklyMarksSheets  WeeklyMarksSheet[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  monthlyExamResults MonthlyExamResult[]

  @@index([classId])
  @@index([batchId])
}

model StdClass {
  id                String             @id @default(uuid())
  className         String             @unique
  subjects          Subject[]
  students          Student[]
  batches           Batch[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  weeklyMarksSheets WeeklyMarksSheet[]
  monthlyExamResults MonthlyExamResult[]
  examRoutines      ExamRoutine[]
}

model Subject {
  id                 String              @id @default(uuid())
  subjectName        String
  classId            String
  sortOrder          Int                 @default(0)
  stdClass           StdClass            @relation(fields: [classId], references: [id], onDelete: Cascade)
  weeklyMarksSheets  WeeklyMarksSheet[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  monthlyExamResults MonthlyExamResult[]
  routineSubjects    RoutineSubject[]

  @@unique([classId, subjectName])
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  regNo     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id                  String              @id @default(uuid())
  name                String
  startTime           String
  endTime             String
  classId             String
  stdClass            StdClass            @relation(fields: [classId], references: [id], onDelete: Cascade)
  students            Student[]
  weeklyMarksSheets   WeeklyMarksSheet[]
  monthlyExamResults  MonthlyExamResult[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([classId, name])
}

model WeeklyMarksSheet {
  id            String   @id @default(uuid())
  month         String
  week          String
  publishedDate String
  year          String
  batch         Batch?   @relation(fields: [batchId], references: [id])
  batchId       String?
  stdClass      StdClass @relation(fields: [stdClassId], references: [id])
  stdClassId    String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  subjectId     String
  student       Student? @relation(fields: [studentId], references: [id])
  studentId     String?
  totalMarks    Int
  obtainedMarks Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stdClassId, batchId, subjectId, studentId, week, year])
  @@index([studentId])
  @@index([stdClassId, month, year])
}

model MonthlyExamResult {
  id String @id @default(uuid())
  monthlyExamName String?
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  stdClass   StdClass @relation(fields: [classId], references: [id])
  classId String

  batch   Batch? @relation(fields: [batchId], references: [id])
  batchId String?

  totalMarks Int
  gpa        Float
  grade      String
  position   String
  present    Int
  absent     Int
  // Manual one-time ICT practical adjustment for OLD class 9/10 results (< ICT_PRACTICAL_CUTOFF).
  // Prevents double-add; NEW results (>= cutoff) are created with true.
  ictPracticalAdded Boolean @default(false)

  month String?
  // Exam year selected in form; month/year identify the exam period. createdAt is record save time.
  year  Int?
  // Display-only publish date selected in form; not used for exam month/year semantics.
  publishedDate DateTime?

  results SubjectResult[]

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, month])
  @@index([classId])
}

model SubjectResult {
  id          String  @id @default(uuid())
  subjectName String
  marks       Int
  fullMarks   Int
  highestMark Int
  point       Float
  grade       String
  // Explicit per-subject absence marker. marks=0 alone is ambiguous (real zero vs absent),
  // so isAbsent=false by default preserves old data; new UI sets it explicitly.
  isAbsent    Boolean @default(false)

  examResult   MonthlyExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  examResultId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examResultId])
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  pdfUrl      String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExamRoutine {
  id        String   @id @default(uuid())
  examName  String
  year      String
  month     String?
  classId   String
  stdClass  StdClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  weeks     RoutineWeek[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examName, year, classId])
}

model RoutineWeek {
  id            String           @id @default(uuid())
  routineId     String
  routine       ExamRoutine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  weekNo        Int
  weekLabel     String
  totalMarks    Int
  durationHours Int?
  subjects      RoutineSubject[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([routineId, weekNo])
}

model RoutineSubject {
  id          String   @id @default(uuid())
  weekId      String
  week        RoutineWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  displayName String
  fullMarks   Int
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  alternatives Json    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([weekId, subjectId])
  @@index([subjectId])
}